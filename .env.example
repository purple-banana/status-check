# Postgres connection. With `docker compose --profile db up`, use the bundled database:
DATABASE_URL=postgres://status:status@db:5432/status
# Or start the bundled database on every `docker compose up` (and from deploy/update.sh):
# COMPOSE_PROFILES=db

# Worker
POLL_CONCURRENCY=16
REQUEST_TIMEOUT_MS=10000
# How often the worker looks for due providers; each provider is polled every 60 s.
TICK_MS=15000
# Sent to status pages. Add a contact URL if you run a public instance.
USER_AGENT=status-check/0.1

# MCP server
PORT=3000
# Public hostnames this server answers to (DNS-rebinding protection), comma separated.
ALLOWED_HOSTS=
# Current statuses and incidents are served from memory, reloaded at most this often.
CACHE_TTL_MS=15000

# mcp-use sends anonymous usage telemetry unless this is "false" (the default here).
MCP_USE_ANONYMIZED_TELEMETRY=false
